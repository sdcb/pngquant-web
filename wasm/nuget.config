<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <packageSources>
    <clear />
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" />
    <!-- Sdcb.SimdCodecs previews are published here before they reach nuget.org. Public, read without a key. -->
    <add key="starworks" value="https://proget.starworks.cc:88/nuget/test/v3/index.json" />
  </packageSources>
  <packageSourceMapping>
    <packageSource key="starworks">
      <package pattern="Sdcb.SimdCodecs*" />
    </packageSource>
    <packageSource key="nuget.org">
      <package pattern="*" />
    </packageSource>
  </packageSourceMapping>
</configuration>
